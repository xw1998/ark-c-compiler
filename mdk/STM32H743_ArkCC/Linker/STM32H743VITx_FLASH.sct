; STM32H743VI: 2 MB Flash @ 0x08000000, 1 MB SRAM ����
;   DTCM 128KB @ 0x20000000
;   AXI  512KB @ 0x24000000
;   SRAM1+2+3+4 ��Լ 384KB (������δʹ��)
;
; ER_IROM1 : Flash ����
; RW_IRAM1 : DTCM �� .data/.bss/stack/heap
; RW_AXI   : AXI SRAM �� ArkCC �Ķ�����뻺�� (.ark_heap / .ark_code)

LR_IROM1 0x08000000 0x00200000  {
  ER_IROM1 0x08000000 0x00200000  {
    *.o (RESET, +First)
    *(InRoot$$Sections)
    .ANY (+RO)
    .ANY (+XO)
  }

  ; DTCM ���� RW/ZI��ջ����
  RW_IRAM1 0x20000000 0x00020000  {
    .ANY (+RW +ZI)
  }

  ; AXI SRAM ���� ArkCC ר�ö�
  RW_AXI 0x24000000 0x00080000  {
    *(.ark_heap)
    *(.ark_code)
    *(.ark_buf)
  }
}
